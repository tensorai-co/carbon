#version 450
// One stage of a chain: dst[i] = src[i] * mul + add, with mul and add read from a uniform block.
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) uniform Params { uint mul; uint add; };
layout(set = 0, binding = 1) readonly buffer Src { uint src[]; };
layout(set = 0, binding = 2) writeonly buffer Dst { uint dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    dst[i] = src[i] * mul + add;
}

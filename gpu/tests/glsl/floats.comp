// Floats: the built-ins glslang and Carbon both lower to the same IR operations, and matrices. Each invocation writes
// 32 floats from its input and its neighbour's (inputs in [-4, 4]).
#version 430
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { float data[]; };
layout(std430, binding = 1) buffer Out { float values[]; };

mat3 rotation(float a) {
    float c = cos(a), s = sin(a);
    return mat3(c, s, 0.0, -s, c, 0.0, 0.0, 0.0, 1.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = data[i];
    float y = data[(i + 1u) % 64u];
    float p = abs(x) + 0.5;
    uint b = i * 32u;
    values[b + 0u] = sin(x) + cos(y);
    values[b + 1u] = tan(x * 0.3);
    values[b + 2u] = pow(p, 1.5);
    values[b + 3u] = exp(x * 0.5) + log(p);
    values[b + 4u] = exp2(y) + log2(p);
    values[b + 5u] = sqrt(p) + inversesqrt(p);
    values[b + 6u] = floor(x) + ceil(y) * 10.0 + fract(x * 3.0);
    values[b + 7u] = mod(x, 1.5) + mod(y, -2.0) * 10.0;
    values[b + 8u] = min(x, y) + max(x, y) * 2.0 + clamp(x, -1.0, 0.5) * 4.0;
    values[b + 9u] = mix(x, y, 0.25) + step(0.0, x) + smoothstep(-2.0, 2.0, y);
    values[b + 10u] = sign(x) + abs(y) + trunc(x * 2.5) + round(y * 1.3);
    vec3 v = vec3(x, y, 1.0);
    vec3 w = vec3(y, -x, 0.5);
    values[b + 11u] = length(v) + distance(v, w) + dot(v, w);
    vec3 c = cross(v, w);
    values[b + 12u] = c.x + c.y * 2.0 + c.z * 3.0;
    vec3 n = normalize(w);
    values[b + 13u] = n.x - n.y + n.z;
    vec3 r = reflect(v, n);
    values[b + 14u] = r.x + r.y + r.z;
    vec3 f = faceforward(n, v, w);
    values[b + 15u] = f.x + f.y * 2.0;
    mat3 m = rotation(x) * mat3(2.0);
    vec3 mv = m * v;
    values[b + 16u] = mv.x + mv.y * 10.0 + mv.z * 100.0;
    vec3 vm = v * m;
    values[b + 17u] = vm.x - vm.y + vm.z;
    mat2 a = mat2(x, y, y, x + 1.0);
    mat2 t = transpose(a) * a;
    values[b + 18u] = t[0][0] + t[0][1] * 2.0 + t[1][0] * 3.0 + t[1][1] * 4.0;
    mat3x2 o = outerProduct(vec2(x, y), vec3(1.0, 2.0, 3.0));
    values[b + 19u] = o[2][1] + o[1][0];
    mat2 cm = matrixCompMult(a, mat2(1.0, 2.0, 3.0, 4.0));
    values[b + 20u] = cm[1][0] + cm[0][1];
    mat4 big = mat4(rotation(y));
    values[b + 21u] = big[3][3] + big[0][0] + big[2][2];
    vec4 col = big[1] + vec4(a[0], a[1]);
    values[b + 22u] = col.x + col.y + col.z + col.w;
    values[b + 23u] = float(int(x * 10.0)) + float(uint(abs(y) * 3.0));
    vec2 sw = v.zy * 2.0 + w.xx;
    values[b + 24u] = sw.x + sw.y;
    float acc = 0.0;
    for (int k = 0; k < 5; k++) acc += x * float(k) - y;
    values[b + 25u] = acc;
    values[b + 26u] = x > y ? x * 2.0 : y / 3.0;
    values[b + 27u] = degrees(x) + radians(y * 30.0);
    mat3 m3 = mat3(v, w, c);
    m3[1] = m3[1] * 2.0;
    m3[2].y = 7.0;
    values[b + 28u] = m3[1].x + m3[2].y + m3[0][2];
    values[b + 29u] = fma(x, y, 1.0) - x / (abs(y) + 1.0);
    vec4 q = vec4(x, vec2(y), 1.0) * 0.5 - vec4(1.0);
    values[b + 30u] = q.x + q.y * q.z - q.w;
    values[b + 31u] = intBitsToFloat(floatBitsToInt(x) ^ 0) + uintBitsToFloat(floatBitsToUint(y));
}

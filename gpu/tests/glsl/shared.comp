// Shared memory and barriers: each workgroup sums its 64 inputs by halving, and every invocation adds its input to
// one counter with an atomic. The sums and the counter are what's compared.
#version 430
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { int data[]; };
layout(std430, binding = 1) buffer Out { int counter; int sums[]; };

shared int partial[64];

void main() {
    uint i = gl_LocalInvocationID.x;
    partial[i] = data[gl_GlobalInvocationID.x];
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1) {
        if (i < stride) partial[i] += partial[i + stride];
        barrier();
    }
    if (i == 0u) sums[gl_WorkGroupID.x] = partial[0];
    atomicAdd(counter, data[gl_GlobalInvocationID.x]);
}

  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\vmx.c" />
    <ClCompile Include="src\ept.c" />
  </ItemGroup>
  <ItemGroup>
    <MASM Include="src\vmx_enter.asm" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>

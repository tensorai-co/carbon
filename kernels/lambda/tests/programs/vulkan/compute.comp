#version 450
// vulkan.c's kernel: two storage buffers in set 0, a uniform buffer (bound with a dynamic offset) in set 1, and push
// constants, over a count that isn't a multiple of the workgroup.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer In { uint data[]; } src;
layout(set = 0, binding = 1) buffer Out { uint data[]; } dst;
layout(set = 1, binding = 0) uniform Params { uint bias; } params;
layout(push_constant) uniform Push { uint mul; uint count; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        dst.data[i] = src.data[i] * pc.mul + params.bias + i;
    }
}
